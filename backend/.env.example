PORT=3000
NODE_ENV=development

# MySQL Database (primary database - users, orders, tickets, matches)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=stadium_tickets
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# MongoDB (for flexible data - logs, analytics, sessions)
MONGODB_URI=mongodb://localhost:27017/stadium_tickets

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# API-Football (https://www.api-football.com/) - Free tier: 100 requests/day
# Get your free API key at: https://dashboard.api-football.com/register
API_FOOTBALL_KEY=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
